# RubberDucky credentials — bring your own key (BYOK).
# Enter and manage these through the Settings page (recommended) or edit this
# file directly. The backend stores keys in .env with 0600 permissions.
# .env is local plaintext protected by filesystem permissions, NOT encrypted
# storage. Never commit this file to version control.

# Gnani — enables Prisma STT and Timbre TTS (one shared credential).
GNANI_API=

# OpenRouter — LLM diagnoses (https://openrouter.ai/keys).
OPENROUTER_API_KEY=

# Groq — LLM diagnoses (https://console.groq.com/keys).
GROQ_API_KEY=
